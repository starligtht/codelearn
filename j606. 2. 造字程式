#include <bits/stdc++.h>
using namespace std;
int main()
{
    int k,q,r;
    cin>>k>>q>>r;
    string s;
    cin>>s;
    vector<vector<int>> aq(q,vector<int>(k,0));
    for(int i=0;i<q;i++){
        for(int j=0;j<k;j++){
            cin>>aq[i][j];
        }
    }
    vector<vector<char>> ans(r,vector<char>(q,0));
    for(int i=0;i<q;i++){
        string ta=s;
        for(int j=0;j<k;j++){
            int t=0;
            t=aq[i][j];
            ta[t-1]=s[j];
            if(t<=r){
                ans[t-1][i]=s[j];
            }
        }
        s=ta;
    }
    
    for(int i=0;i<r;i++){
        for(int j=0;j<q;j++){
            cout<<ans[i][j];
        }
        cout<<endl;
    }
    return 0;
}
