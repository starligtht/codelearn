#include <bits/stdc++.h>
using namespace std;

int main(){
  string s;
  cin >> s;
  int k;
  cin >> k;
  while(k--){
    int op;
    cin >> op;
    if(op == 0){
      for(int i = 0; i < s.size(); i = i+2){
        swap(s[i], s[i+1]);
      }
    }else if(op == 1){
      for(int i = 0; i < s.size(); i = i+2){  
        if(s[i] > s[i+1])  swap(s[i], s[i+1]);
      }
    }else if(op == 2){
      int mid = s.size() / 2;
      string temp = "";
      for(int i = 0; i < mid; ++i){
        temp += s[i];
        temp += s[i+mid];
      }
      s = temp;
    }
  }
  cout << s <<endl;
  return 0;
}
